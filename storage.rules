rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null && request.auth.token.active == true; }
    function isManager() { return active() && request.auth.token.role in ['manager', 'owner', 'engineer']; }

    // 自動抓的官網主圖，只有 Cloud Functions 寫入
    match /products/{file} {
      allow read: if active();
    }
    // 開支收據
    match /receipts/{expenseId}/{file} {
      allow read: if isManager();
      allow write: if isManager() && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    // 上傳待轉檔的影片／音檔（轉成 mp3 後伺服器會刪掉）
    match /soundsrc/{file} {
      allow write: if isManager()
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('audio/.*'));
    }
    // 商品縮圖（Cloud Functions 產生）
    match /thumbs/{path=**} {
      allow read: if active();
    }
    // 結帳音效（設定頁上傳）
    match /sounds/{file} {
      allow read: if active();
      allow write: if isManager()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    // 「商品與條碼」頁手動上傳的圖片
    match /manual/{productId}/{file} {
      allow read: if active();
      allow write: if isManager()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
