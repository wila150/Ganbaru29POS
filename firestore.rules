rules_version = '2';

// 前端只能「讀」庫存與紀錄（即時更新），所有寫入一律經過 Cloud Functions。
// 例外：老闆可改 settings/shop 的一般設定；收銀員可存掛單（posHolds）。
service cloud.firestore {
  match /databases/{database}/documents {
    function active() { return request.auth != null && request.auth.token.active == true; }
    function isManager() { return active() && request.auth.token.role in ['manager', 'owner', 'engineer']; }
    // engineer（工程師）與老闆同等權限
    function isOwner() { return active() && request.auth.token.role in ['owner', 'engineer']; }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isManager());
    }
    match /invites/{id} {
      allow read: if isOwner();
    }

    match /variants/{id} { allow read: if active(); }
    match /codes/{code} { allow read: if active(); }
    match /productImages/{id} { allow read: if active(); }
    match /movements/{id} { allow read: if active(); }
    match /stocktakes/{id} {
      allow read: if active();
      match /items/{variantId} { allow read: if active(); }
    }
    // 成本只有老闆看得到
    match /costs/{id} { allow read: if isOwner(); }
    match /syncLogs/{id} { allow read: if isManager(); }

    match /shoppers/{id} { allow read: if active(); }
    match /posOrders/{id} { allow read: if active(); }
    match /posPayments/{id} { allow read: if active(); }
    match /locationStock/{id} { allow read: if active(); }

    // 開支：店長以上新增／修改／刪除（錢櫃提款記為開支由伺服器寫入）；金額、成本相關只限店長以上看
    match /expenses/{id} {
      allow read, delete: if isManager();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['date', 'category', 'amount', 'note', 'payMethod', 'vendor', 'locationId', 'receiptPath', 'receiptUrl', 'source', 'shiftId', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.category is string && request.resource.data.category.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0;
    }
    // 打卡：員工看自己的，店長以上看全部；寫入一律經過 Cloud Functions
    match /attendance/{id} { allow read: if active() && (resource.data.uid == request.auth.uid || isManager()); }
    match /auditLogs/{id} { allow read: if isManager(); }
    // 優惠碼：收銀員掃碼時要能查；建立、停用經過 Cloud Functions
    match /coupons/{code} { allow read: if active(); }
    match /transfers/{id} { allow read: if active(); }
    match /shifts/{id} { allow read: if active(); }

    // 促銷活動：店長以上可以新增、修改；結帳時由 posCheckout 重算
    match /promotions/{id} {
      allow read: if active();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['name', 'active', 'type', 'startDate', 'endDate', 'scope', 'excludeScope', 'percentOff', 'amountOff', 'n', 'bundlePrice',
             'addonScope', 'addonPrice', 'thresholdType', 'threshold', 'thresholdReward', 'repeat', 'memberRule', 'memberTiers', 'memberGroups',
             'days', 'timeFrom', 'timeTo', 'minSpend', 'maxUses', 'noMemberStack', 'couponOnly', 'levels', 'orderLevel', 'note', 'updatedBy', 'updatedAt', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.type in ['percent_off', 'amount_off', 'nth_discount', 'bundle_price', 'addon', 'threshold', 'gift']
        && request.resource.data.active is bool;
      allow delete: if isManager();
    }

    match /posHolds/{id} {
      allow read, delete: if active();
      allow create, update: if active()
        && request.resource.data.keys().hasOnly(['label', 'cart', 'shopper', 'note', 'guests', 'discounts', 'by', 'byName', 'at'])
        && request.resource.data.cart is list
        && request.resource.data.cart.size() <= 100
        && request.resource.data.by == request.auth.uid;
    }

    match /settings/shop {
      allow read: if active();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(ownerKeys());
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerKeys());
    }
    function ownerKeys() {
      return ['shopName', 'leadDays', 'expiryDays', 'lineTargets', 'rewardPercent', 'pointValue',
              'staffCanRefund', 'siteBaseUrl', 'receiptHeader', 'receiptFooter', 'serviceFeeDefault', 'shiftNames',
              'memberTiers', 'birthdayGiftPoints', 'birthdayPointMultiplier', 'tagTemplate', 'payment', 'invoice',
              'locations', 'onlineLocationId', 'merchantId', 'commissionPct', 'commissionByUser', 'expenseCategories', 'rewardRules', 'pointGifts', 'lineLogin'];
    }
  }
}
